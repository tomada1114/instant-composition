# Copy this file to .env and fill in what you need. Every name below is
# declared in src/server/env.ts, which is the only place this application
# reads process.env; tests/server-env.test.ts fails when the two drift apart.

# Shared secret a caller of a protected endpoint must send as `Authorization:
# Bearer <value>`. Optional while nothing served costs money to answer, and
# required as soon as an endpoint that bills a provider is wired: readServerEnv
# refuses that combination, so a deployment that pays for answers cannot leave
# the endpoint open. It buys authentication only: this app ships no rate limit.
API_ACCESS_KEY=

# The content root the cards are read from (taxonomy.json, levels.json, cards/,
# tombstones.jsonl). Defaults to content/ under the working directory.
CONTENT_DIR=

# The SQLite file progress is kept in. Defaults to data/progress.sqlite under
# the working directory; the directory is created on first use.
PROGRESS_DB_PATH=
