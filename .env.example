# Every variable a local run of the stack reads (`pnpm dev`, `pnpm api`,
# `pnpm web`), each with an empty value. Set a name in the shell that starts
# the run, or in a gitignored .env.local at the repository root: `pnpm api`,
# and `pnpm dev`'s API process, start Node with `--env-file-if-exists=.env.local`,
# and a name the shell sets wins over the file. Nothing else loads it — not the
# web client, not a test, not the smoke suite. Every name has a default or is
# optional, so none has to be set. apps/api/src/env.ts declares them, and
# tests/env-example.test.ts fails when the two drift apart.

# The port the API listens on, on 127.0.0.1 only. The web client's Vite dev
# server and `vite preview` proxy /api to it. Defaults to 8787.
API_PORT=

# DynamoDB local's endpoint, on the loopback interface only (`pnpm db:up`
# publishes it). Defaults to http://localhost:8000.
API_DYNAMODB_ENDPOINT=

# The learner table, created on first start. Defaults to
# instant-composition-local.
API_TABLE_NAME=

# The catalog snapshot `pnpm catalog:build` writes, relative to the repository
# root or absolute. Defaults to dist/catalog/en/ja.json, which `pnpm dev` builds
# when it is missing; a snapshot named here is never built for you.
API_CATALOG_PATH=

# The Cognito user pool the API verifies access tokens against, and the web
# app client and domain it signs a browser in through: the `UserPoolId`,
# `WebClientId` and `SignInDomainUrl` outputs of the dev foundation stack
# (e.g. ap-northeast-1_AbC123 and https://<prefix>.auth.<region>.amazoncognito.com),
# and that client's secret, which is not an output. Set all four or none: with
# all four, a request needs `Authorization: Bearer <access token>` or the
# session cookie, which /api/v1/auth/login sets; with none, every request is
# the one local stand-in learner. The client secret is a credential: set it in
# your shell only, never in a file under version control. The start-up line
# says which authenticator ran.
API_COGNITO_USER_POOL_ID=
API_COGNITO_CLIENT_ID=
API_COGNITO_CLIENT_SECRET=
API_COGNITO_DOMAIN=

# The talk activity's model. With API_OPENROUTER_API_KEY set, talks call
# OpenRouter at API_MODEL_ID (defaults to anthropic/claude-haiku-4.5); without
# it, a scripted stand-in model answers and nothing is called. The key is a
# credential: keep it in .env.local or your shell, never in a tracked file. The
# start-up line says which model ran.
API_OPENROUTER_API_KEY=
API_MODEL_ID=
