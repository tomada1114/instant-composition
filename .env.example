# Every variable a local run of the stack reads (`pnpm dev`, `pnpm api`,
# `pnpm web`), each with an empty value. Nothing loads a .env file: set a name
# in the shell that starts the run. Every one has a default or is optional, so
# none has to be set. apps/api/src/env.ts declares them, and tests/env-example.test.ts fails
# when the two drift apart.

# The port the API listens on, on 127.0.0.1 only. The web client's Vite dev
# server and `vite preview` proxy /api to it. Defaults to 8787.
API_PORT=

# DynamoDB local's endpoint, on the loopback interface only (`pnpm db:up`
# publishes it). Defaults to http://localhost:8000.
API_DYNAMODB_ENDPOINT=

# The learner table, created on first start. Defaults to
# instant-composition-local.
API_TABLE_NAME=

# The catalog snapshot `pnpm catalog:build` writes, relative to the repository
# root or absolute. Defaults to dist/catalog/en/ja.json, which `pnpm dev` builds
# when it is missing; a snapshot named here is never built for you.
API_CATALOG_PATH=

# The Cognito user pool and app client whose access tokens the API verifies,
# e.g. ap-northeast-1_AbC123 and the client's id. Set both or neither: with
# both, a request needs `Authorization: Bearer <access token>` or the session
# cookie; with neither, every request is the one local stand-in learner. Both
# are identifiers, not secrets; the start-up line says which authenticator ran.
API_COGNITO_USER_POOL_ID=
API_COGNITO_CLIENT_ID=
