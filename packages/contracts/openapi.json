{
  "openapi": "3.1.1",
  "info": { "title": "Instant Composition API", "version": "1" },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/v1/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "The settings as saved, the topics to choose from and the difficulty now.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SettingsPageView" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateSettings",
        "summary": "Changes the fields the body sets.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SettingsPatch" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SettingsView" }
              }
            }
          },
          "400": {
            "description": "ERR_BAD_REQUEST: The request does not fit the round or the settings it names.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "ERR_CONFLICT: Another write to the same data kept winning; send the request again.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "ERR_PAYLOAD_TOO_LARGE: The request body is too large.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "ERR_CONTENT_UNREADABLE: The card content could not be read.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/home": {
      "get": {
        "operationId": "getHome",
        "summary": "The home view: today's portion, the streak and the next action.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HomeView" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/rounds": {
      "post": {
        "operationId": "startRound",
        "summary": "Starts a round of the kind asked for, or resumes today's open one; a retried start with the same roundId answers the round it made.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StartRoundRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoundPayload" }
              }
            }
          },
          "400": {
            "description": "ERR_BAD_REQUEST: The request does not fit the round or the settings it names.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "ERR_CONFLICT: Another write to the same data kept winning; send the request again. ERR_ROUND_CLOSED: That round or day can no longer take this request. ERR_NOT_ENOUGH_CARDS: Too few reviewed cards can be dealt for a round.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "ERR_PAYLOAD_TOO_LARGE: The request body is too large.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "ERR_CONTENT_UNREADABLE: The card content could not be read.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/rounds/{roundId}/answers": {
      "post": {
        "operationId": "recordAnswers",
        "summary": "Records a batch of answers; ids the round already holds are ignored.",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnswersRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Done; no body." },
          "400": {
            "description": "ERR_BAD_REQUEST: The request does not fit the round or the settings it names.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "ERR_ROUND_NOT_FOUND: No round has that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "ERR_CONFLICT: Another write to the same data kept winning; send the request again. ERR_ROUND_CLOSED: That round or day can no longer take this request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "ERR_PAYLOAD_TOO_LARGE: The request body is too large.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "ERR_CONTENT_UNREADABLE: The card content could not be read.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/rounds/{roundId}/finish": {
      "post": {
        "operationId": "finishRound",
        "summary": "Records the round's last answers and closes it; a finished round answers the summary it kept.",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnswersRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoundSummary" }
              }
            }
          },
          "400": {
            "description": "ERR_BAD_REQUEST: The request does not fit the round or the settings it names.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "ERR_ROUND_NOT_FOUND: No round has that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "ERR_CONFLICT: Another write to the same data kept winning; send the request again. ERR_ROUND_CLOSED: That round or day can no longer take this request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "ERR_PAYLOAD_TOO_LARGE: The request body is too large.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "ERR_CONTENT_UNREADABLE: The card content could not be read.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/rounds/{roundId}/summary": {
      "get": {
        "operationId": "getRoundSummary",
        "summary": "The kept summary of a finished round; a round not finished is not found.",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoundSummary" }
              }
            }
          },
          "400": {
            "description": "ERR_BAD_REQUEST: The request does not fit the round or the settings it names.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "ERR_ROUND_NOT_FOUND: No round has that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/records": {
      "get": {
        "operationId": "getRecords",
        "summary": "The records view: mastery by topic, the run, the calendar and the totals.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecordsView" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "get": {
        "operationId": "getHistory",
        "summary": "What the card-planning tooling reads: the cards seen, the choices and the level.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/History" }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: The caller may not run this operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoundKind": {
        "type": "string",
        "enum": ["placement", "today", "yesterday", "extra"]
      },
      "Pass": { "type": "string", "enum": ["first", "retry"] },
      "AnswerResult": { "type": "string", "enum": ["ok", "ng", "timeout"] },
      "SubtopicRef": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 64 },
          "subtopic": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "required": ["topic", "subtopic"]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "topics": { "type": "array", "items": { "type": "string" } },
          "focus": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SubtopicRef" }
          },
          "dailySize": {
            "anyOf": [
              { "type": "number", "const": 5 },
              { "type": "number", "const": 10 },
              { "type": "number", "const": 15 },
              { "type": "number", "const": 20 },
              { "type": "number", "const": 30 }
            ]
          },
          "sound": { "type": "boolean" }
        },
        "required": ["topics", "focus", "dailySize", "sound"]
      },
      "Dot": {
        "type": "object",
        "properties": {
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "state": { "type": "string", "enum": ["done", "gap", "missed", "upcoming"] }
        },
        "required": ["day", "state"]
      },
      "RingProgress": {
        "type": "object",
        "properties": {
          "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "to": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "done": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "span": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["from", "to", "done", "span"]
      },
      "ReachTopic": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "added": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "ring": { "$ref": "#/components/schemas/RingProgress" }
        },
        "required": ["id", "name", "count", "added", "ring"]
      },
      "ReachView": {
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReachTopic" }
          },
          "nearest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "remaining": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["name", "remaining"]
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["topics", "nearest"]
      },
      "StartRoundRequest": {
        "type": "object",
        "properties": {
          "roundId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "$ref": "#/components/schemas/RoundKind" }
        },
        "required": ["roundId", "kind"]
      },
      "Answer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "cardId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "pass": { "$ref": "#/components/schemas/Pass" },
          "result": { "$ref": "#/components/schemas/AnswerResult" },
          "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 600000 }
        },
        "required": ["id", "cardId", "pass", "result", "elapsedMs"]
      },
      "AnswersRequest": {
        "type": "object",
        "properties": {
          "answers": {
            "maxItems": 60,
            "type": "array",
            "items": { "$ref": "#/components/schemas/Answer" }
          }
        },
        "required": ["answers"]
      },
      "SettingsPatch": {
        "type": "object",
        "properties": {
          "topics": {
            "maxItems": 50,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "focus": {
            "maxItems": 50,
            "type": "array",
            "items": { "$ref": "#/components/schemas/SubtopicRef" }
          },
          "dailySize": {
            "anyOf": [
              { "type": "number", "const": 5 },
              { "type": "number", "const": 10 },
              { "type": "number", "const": 15 },
              { "type": "number", "const": 20 },
              { "type": "number", "const": 30 }
            ]
          },
          "sound": { "type": "boolean" }
        }
      },
      "DrillCard": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" },
          "subtopic": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "words": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "prompt": { "type": "string" },
          "text": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" },
          "limitMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": [
          "id",
          "topic",
          "subtopic",
          "level",
          "words",
          "prompt",
          "text",
          "alternatives",
          "explanation",
          "limitMs"
        ]
      },
      "RoundPayload": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/RoundKind" },
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "portionDay": {
            "anyOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "type": "null" }
            ]
          },
          "deck": { "type": "array", "items": { "type": "string" } },
          "cards": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": { "$ref": "#/components/schemas/DrillCard" }
          },
          "answered": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cardId": { "type": "string" },
                "pass": { "$ref": "#/components/schemas/Pass" },
                "result": { "$ref": "#/components/schemas/AnswerResult" }
              },
              "required": ["cardId", "pass", "result"]
            }
          },
          "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "retries": { "type": "boolean" }
        },
        "required": [
          "id",
          "kind",
          "day",
          "portionDay",
          "deck",
          "cards",
          "answered",
          "offset",
          "total",
          "retries"
        ]
      },
      "GrowthRow": {
        "type": "object",
        "properties": {
          "cardId": { "type": "string" },
          "prompt": { "type": ["string", "null"] },
          "kind": { "type": "string", "enum": ["faster", "fixed"] },
          "deltaMs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["cardId", "prompt", "kind", "deltaMs"]
      },
      "Growth": {
        "type": "object",
        "properties": {
          "faster": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "fixed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "compared": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "firstTime": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "rows": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GrowthRow" }
          }
        },
        "required": ["faster", "fixed", "compared", "firstTime", "rows"]
      },
      "ReviewRow": {
        "type": "object",
        "properties": {
          "cardId": { "type": "string" },
          "prompt": { "type": ["string", "null"] }
        },
        "required": ["cardId", "prompt"]
      },
      "TotalsView": {
        "type": "object",
        "properties": {
          "said": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "practicedDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last14": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["day", "count"]
            }
          },
          "added": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["said", "practicedDays", "last14", "added"]
      },
      "RoundSummary": {
        "type": "object",
        "properties": {
          "roundId": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/RoundKind" },
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "yesterday": { "type": "boolean" },
          "placement": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "toeic": { "type": "string" },
                  "first": { "type": "boolean" }
                },
                "required": ["level", "toeic", "first"]
              },
              { "type": "null" }
            ]
          },
          "growth": { "$ref": "#/components/schemas/Growth" },
          "review": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReviewRow" }
          },
          "streak": {
            "type": "object",
            "properties": {
              "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "restart": { "type": "boolean" },
              "changed": { "type": "boolean" }
            },
            "required": ["value", "restart", "changed"]
          },
          "week": { "type": "array", "items": { "$ref": "#/components/schemas/Dot" } },
          "filled": {
            "anyOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "type": "null" }
            ]
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "change": { "type": "string", "enum": ["up", "down"] },
                  "toeic": { "type": "string" }
                },
                "required": ["change", "toeic"]
              },
              { "type": "null" }
            ]
          },
          "reach": { "$ref": "#/components/schemas/ReachView" },
          "titles": { "type": "array", "items": { "type": "string" } },
          "topicNames": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": { "type": "string" }
          },
          "points": {
            "type": "object",
            "properties": {
              "earned": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
