{
  // The one package that performs I/O: it reads the catalog snapshot from disk
  // and talks to DynamoDB, so it compiles against Node's types, unlike the pure
  // packages beside it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src"]
}
